node_modules/
dist/
.vite/
*.local

# Design docs — kept local, not published to public repo
# (CLAUDE.md is deliberately NOT ignored: it's the operational handoff
# doc for coding sessions — no design content, no secrets.)
gdd-*.md
creative-reference-*.md
architecture.md
development-playbook-*.md
# v2.3.1201: .claude/ stays local (worktrees, session state) EXCEPT the
# project settings file — the SessionStart hook that briefs every AI
# session lives there and must ship with the repo.
.claude/*
!.claude/settings.json
# v2.3.1204: the shared review protocol (/repo-review) ships with the
# repo too — same carve-out pattern as settings.json.
!.claude/commands/

# Python bytecode cache
__pycache__/
*.pyc

# Importer validation composites (dev artifacts)
tools/posesheets/_validate_*.png
assets-archive/

# Shirt-preview dev artifacts (tools/preview_shirt_frames.py output)
tools/_*.png

# Gear-art contact sheets (tools/qa/qa-gear-sheet.mjs output — v2.3.1195)
tools/qa/out/
# mp-scenario screenshots (tools/qa/mp/run.mjs output — v2.3.1781)
tools/qa/mp/out/
# v2.3.2073: the town-layout render is a generated picture (5.8MB), rebuilt by
# tools/maps/render_town_layout.py from the live data. Committing it would put
# a big binary in every diff that moves a prop, and it would go stale the
# moment one moved without a re-run.
tools/maps/out/

# v2.3.1710: throwaway QA probe scripts at the REPO ROOT.
#
# The headless harness (tools/qa/mp/harness.mjs) can only be imported from a
# script sitting at the repo root — playwright-core does not resolve from /tmp
# — so every session that needs a one-off probe (screenshot this panel, dump
# that state, diff those pixels) writes a scratch .mjs here and deletes it
# afterwards.  Sessions forget, and in-flight parallel agents cannot have
# theirs deleted out from under them, so these keep landing in `git status`
# and inviting someone to commit them.
#
# Anchored to the root on purpose: `/*.mjs` does NOT match tools/**.mjs,
# server/**.mjs or anything else real.  Zero root-level .mjs files are tracked
# today, and a genuinely permanent one belongs in tools/ anyway.
/*.mjs

# v2.3.1923: generated headwear preview sheets (tools/qa/preview-headwear.mjs).
# Regenerate on demand; 4MB of PNGs has no business in the history.
preview/

# v2.3.1979: mp-lockon writes a debug screenshot next to itself on every run.
tools/qa/mp/.last-*.png

# v2.3.1997 / v2.3.2002: QA scenarios drop debug screenshots in tools/maps as
# dotfiles, and three of them were TRACKED — .cc.png (mp-ccload), .hero.png
# (mp-heroview) and .blade.png.  So any QA run left phantom "modified" files in
# the working tree, and they were swept into unrelated commits as binary churn
# (4266debf, 5195ef93 — .blade.png has no other commit and no code reference at
# all, which is what an accident looks like).  Ignored as a CLASS rather than
# one name at a time: the next scenario to add one should not need this edit.
# Same reasoning as .last-*.png above — regenerate them, don't version them.
tools/maps/.*.png

# v2.3.2061: importer contact sheets are a LOOK-AT-IT artifact, regenerated by
# tools/import_*.py on every run. The source sheets in assets/ are tracked;
# these are not.
tools/*-contact.png
dist-verify/
# v2.3.2078: the staging copy a build is written to while a QA sweep is still
# serving dist/. Files are read per request, so rebuilding dist/ under a
# running batch hands its in-flight scenarios truncated bundles; the build
# goes here and is swapped in at a batch boundary. Same reason dist-verify/ is
# here, and just as much a build artefact.
dist-new/
dist-old/
